# ==========================================
# Variables de entorno - ObraNeta API & Web
# ==========================================

# Puerto de la API HTTP
PORT=3001

# Configuración del motor de Base de Datos: 'mysql' (producción/Docker) o 'sqlite' (modo portátil sin Docker)
DB_DRIVER=mysql

# Conexión MySQL 8.4 (InnoDB, utf8mb4)
DB_HOST=localhost
DB_PORT=3306
DB_USER=obraneta_user
DB_PASSWORD=obraneta_password
DB_NAME=obraneta

# Base de datos separada obligatoria para pruebas de integración MySQL (evita sobreescribir desarrollo)
DB_NAME_TEST=obraneta_test

# Ruta de archivo SQLite (para driver SQLite / fallback sin Docker)
DB_PATH=./data/obraneta.sqlite

# Carga automática de migraciones y semillas al arrancar el servidor
AUTO_SEED=true

# Frontend Vite
VITE_PORT=5173
VITE_API_TARGET=http://localhost:3001
